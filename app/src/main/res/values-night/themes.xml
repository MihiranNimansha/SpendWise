<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark application theme -->
    <style name="Theme.SpendWise" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/colorSecondary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorDarkTextPrimary</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Error -->
        <item name="colorError">@color/colorPanic</item>
        <item name="colorOnError">@color/colorOnError</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/colorDarkBackground</item>
        <item name="colorOnBackground">@color/colorDarkTextPrimary</item>
        <!-- Surface -->
        <item name="colorSurface">@color/colorDarkSurface</item>
        <item name="colorOnSurface">@color/colorDarkTextPrimary</item>
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/colorDarkSurface</item>
        <item name="android:navigationBarColor">@color/colorDarkBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
